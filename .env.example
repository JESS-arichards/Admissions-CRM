NODE_ENV=development
PORT=8081
PUBLIC_BASE_URL=http://localhost:5174
APPLICATIONS_PORTAL_URL=https://your-portal.azurewebsites.net
# Match PLATFORM_ADMISSIONS_KEY in the Portal. Server-only, at least 32 characters.
PLATFORM_API_KEY=
# Independent of the Portal session secret; at least 32 characters.
SESSION_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Use the same Entra/Graph/mail names and matching-environment values as the Portal.
# ENTRA_CLIENT_SECRET is not used for SPA sign-in or as a fallback for GRAPH_CLIENT_SECRET.
# ENTRA_ALLOWED_DOMAINS and INITIAL_ADMIN_EMAIL are enforced only by the central Portal.
# Use a NEW Admissions database, never the Portal database.
SQL_SERVER=
SQL_DATABASE=
SQL_AUTH=managed-identity
SQL_MANAGED_IDENTITY_CLIENT_ID=
# Precedence: SQL_CONNECTION_STRING > Azure SQLAZURECONNSTR_DefaultConnection > discrete settings.
# Connection-string credentials/auth override SQL_AUTH, SQL_USER / SQL_PASSWORD and managed identity settings.
# For discrete SQL credentials use SQL_AUTH=sql and both SQL_USER / SQL_PASSWORD.
SQL_CONNECTION_STRING=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
# Optional DEVELOPMENT Azure SQL serverless auto-pause support. Leave false in production.
# true disables automatic mail polling; a central Full Admin must run queued mail manually.
# Set the dev App Service Health check / uptime probe path to /api/live (no SQL/downstream calls).
# Run mail from the signed-in Admissions origin: POST /api/admin/background-jobs/run with JSON {}.
SQL_SERVERLESS_ENABLED=false
# Optional Azure-only private enquiry documents. No local disk fallback.
# Server-only HTTPS account-key connection string and pre-created private container.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=admissions-files
# Set GRAPH_CLIENT_SECRET and MAIL_FROM_ADDRESS to enable email. Graph application Mail.Send permission required.
# GRAPH_TENANT_ID / GRAPH_CLIENT_ID are optional and default to ENTRA_TENANT_ID / ENTRA_CLIENT_ID.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM_ADDRESS=
# Number of trusted reverse-proxy hops; Azure App Service typically uses 1.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
